generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model User {
  id                Int                @id @default(autoincrement())
  email             String             @unique
  password          String
  name              String
  createdAt         DateTime           @default(now())

  babies            Baby[]
  pushSubscriptions PushSubscription[]
}

model Baby {
  id        Int       @id @default(autoincrement())
  userId    Int
  name      String
  birthDate DateTime  @db.Date
  gender    String?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id])  // ← 추가!
  feedings  Feeding[]
  meals     Meal[]
    notificationSettings NotificationSetting[]
  notificationLogs     NotificationLog[]
}

model Feeding {
  id          Int      @id @default(autoincrement())
  babyId      Int
  type        String
  amountMl    Int?
  durationMin Int?
  fedAt       DateTime @db.Timestamptz
  createdAt   DateTime @default(now())

  baby        Baby     @relation(fields: [babyId], references: [id])
}

model Meal {
  id        Int      @id @default(autoincrement())
  babyId    Int
  menu      String
  amountG   Int?
  reaction  String?
  memo      String?
  eatenAt   DateTime @db.Timestamptz
  createdAt DateTime @default(now())

  baby      Baby     @relation(fields: [babyId], references: [id])
}

model NotificationSetting {
  id          Int      @id @default(autoincrement())
  babyId      Int
  type        String   // 'feeding' | 'meal'
  mode        String   // 'interval' | 'fixed'
  intervalMin Int?     // mode='interval'일 때 (예: 180 = 3시간)
  fixedTimes  String?  // mode='fixed'일 때, "09:00,13:00,17:00" 형태
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  baby        Baby     @relation(fields: [babyId], references: [id])
}

model NotificationLog {
  id          Int      @id @default(autoincrement())
  babyId      Int
  type        String   // 'feeding' | 'meal'
  scheduledAt DateTime // 알림이 발송된(또는 예정된) 시각
  status      String   @default("pending") // 'pending' | 'done' | 'skipped'
  createdAt   DateTime @default(now())

  baby        Baby     @relation(fields: [babyId], references: [id])
}